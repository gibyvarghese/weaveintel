{
  "name": "@weaveintel/prompts",
  "version": "0.2.3",
  "description": "Prompt management — versioned templates, variable substitution, instruction bundles, A/B experiments, scoped resolution",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gibyvarghese/weaveintel.git",
    "directory": "packages/prompts"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@weaveintel/core": "^0.2.0"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ]
}
