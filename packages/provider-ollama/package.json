{
  "name": "@weaveintel/provider-ollama",
  "version": "0.1.4",
  "description": "Ollama provider for weaveIntel — local LLMs (Llama, Mistral, Qwen, Phi, Gemma, DeepSeek, etc.)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gibyvarghese/weaveintel.git",
    "directory": "packages/provider-ollama"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@weaveintel/core": "^0.3.0",
    "@weaveintel/tools": "^0.2.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
