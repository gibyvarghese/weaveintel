{
  "name": "@weaveintel/live-agents-runtime",
  "version": "0.2.4",
  "description": "Generic, DB-driven runtime atop @weaveintel/live-agents — handler registry + built-in plugins (agentic.react, deterministic.forward).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@weaveintel/a2a": "^0.4.0",
    "@weaveintel/agents": "^0.3.2",
    "@weaveintel/core": "^0.3.1",
    "@weaveintel/live-agents": "^0.1.5",
    "@weaveintel/tools": "^0.2.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gibyvarghese/weaveintel.git",
    "directory": "packages/live-agents-runtime"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@weaveintel/provider-anthropic": "^0.1.3"
  }
}
