{
  "name": "@weaveintel/provider-openai",
  "version": "0.1.3",
  "description": "OpenAI provider for weaveIntel — chat, embeddings, image generation, audio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gibyvarghese/weaveintel.git",
    "directory": "packages/provider-openai"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@weaveintel/core": "^0.3.0",
    "@weaveintel/resilience": "^0.1.3",
    "@weaveintel/tools": "^0.2.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
