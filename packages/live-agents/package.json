{
  "name": "@weaveintel/live-agents",
  "version": "0.1.4",
  "description": "Persistent autonomous agent primitives for weaveIntel",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./trace-tools": {
      "import": "./dist/trace-tools/index.js",
      "types": "./dist/trace-tools/index.d.ts",
      "default": "./dist/trace-tools/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.810.0",
    "@aws-sdk/lib-dynamodb": "^3.810.0",
    "@weaveintel/agents": "^0.2.2",
    "@weaveintel/core": "^0.3.0",
    "@weaveintel/identity": "^0.1.4",
    "@weaveintel/mcp-client": "^0.1.3",
    "@weaveintel/memory": "^0.1.4",
    "@weaveintel/observability": "^0.2.1",
    "@weaveintel/tools": "^0.2.2",
    "better-sqlite3": "^11.10.0",
    "mongodb": "^6.16.0",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@weaveintel/mcp-server": "^0.2.2",
    "@weaveintel/testing": "^0.1.3",
    "@testcontainers/postgresql": "^11.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gibyvarghese/weaveintel.git",
    "directory": "packages/live-agents"
  },
  "publishConfig": {
    "access": "public"
  }
}
