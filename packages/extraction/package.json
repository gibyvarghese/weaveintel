{
  "name": "@weaveintel/extraction",
  "version": "0.2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@weaveintel/core": "^0.1.3",
    "@weaveintel/guardrails": "^0.2.1"
  },
  "devDependencies": {
    "pdfjs-dist": "5.7.284",
    "postal-mime": "4.2.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/__tests__/**"
  ],
  "description": "Structured data extraction from text and documents, and file understanding: readers, schema-forced extraction, validation and provenance.",
  "peerDependencies": {
    "pdfjs-dist": ">=4 <6",
    "postal-mime": ">=2 <5"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    },
    "postal-mime": {
      "optional": true
    }
  }
}
