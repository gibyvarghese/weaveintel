{
  "name": "@weaveintel/mcp-server",
  "version": "0.3.0",
  "description": "MCP server — expose tools/resources/prompts via MCP protocol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gibyvarghese/weaveintel.git",
    "directory": "packages/mcp-server"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@weaveintel/core": "^0.3.1"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ]
}
