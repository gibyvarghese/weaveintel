{
  "name": "@weaveintel/agents",
  "version": "0.3.2",
  "description": "Agent runtime — tool-calling loop, planner-executor, hierarchical supervisor-worker, swarms defined as data",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gibyvarghese/weaveintel.git",
    "directory": "packages/agents"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./recipes": {
      "import": "./dist/recipes/index.js",
      "types": "./dist/recipes/index.d.ts",
      "default": "./dist/recipes/index.js"
    },
    "./swarm": {
      "import": "./dist/swarm/index.js",
      "types": "./dist/swarm/index.d.ts",
      "default": "./dist/swarm/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@weaveintel/a2a": "^0.4.0",
    "@weaveintel/core": "^0.3.1",
    "@weaveintel/cost-governor": "^0.2.2",
    "@weaveintel/guardrails": "^0.2.2",
    "@weaveintel/human-tasks": "^0.1.4",
    "@weaveintel/memory": "^0.1.4",
    "@weaveintel/prompts": "^0.2.4",
    "@weaveintel/testing": "^0.1.3"
  },
  "devDependencies": {
    "@weaveintel/observability": "^0.2.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ]
}
