{
  "contract": "mapping-transforms",
  "version": 1,
  "about": "The one closed transform vocabulary shared by schemaWeave @schemaweave/inbound (the engine for inbound data) and weaveIntel @weaveintel/connect (the operation runner). Carried byte for byte in both libraries; both test suites run every vector. {\"$undefined\": true} means the value was refused (not read). A change here is a contract change: bump version, change both libraries in the same release.",
  "transforms": ["none", "trim", "lowercase", "uppercase", "number", "boolean", "date", "epoch_to_datetime", "default_if_empty", "join_lines", "split_lines", "minor_units_to_decimal", "choice_map"],
  "vectors": [
    { "t": "none", "in": "  Kept As Is ", "out": "  Kept As Is " },
    { "t": "none", "in": 42, "out": 42 },
    { "t": "trim", "in": "  padded  ", "out": "padded" },
    { "t": "trim", "in": 7, "out": 7 },
    { "t": "lowercase", "in": "MiXeD", "out": "mixed" },
    { "t": "lowercase", "in": true, "out": true },
    { "t": "uppercase", "in": "MiXeD", "out": "MIXED" },

    { "t": "number", "in": "12.5", "out": 12.5 },
    { "t": "number", "in": 12.5, "out": 12.5 },
    { "t": "number", "in": "$1,234.56", "out": 1234.56 },
    { "t": "number", "in": "(1,234.50)", "out": -1234.5 },
    { "t": "number", "in": "45%", "out": 45 },
    { "t": "number", "in": "1 234 567", "out": 1234567 },
    { "t": "number", "in": "1.234", "out": { "$undefined": true } },
    { "t": "number", "arg": "dot_decimal", "in": "1.234", "out": 1.234 },
    { "t": "number", "arg": "comma_decimal", "in": "1.234", "out": 1234 },
    { "t": "number", "arg": "comma_decimal", "in": "1.234,56", "out": 1234.56 },
    { "t": "number", "in": "1.234,56", "out": 1234.56 },
    { "t": "number", "in": "1.234.567", "out": 1234567 },
    { "t": "number", "in": "abc", "out": { "$undefined": true } },
    { "t": "number", "in": "", "out": { "$undefined": true } },
    { "t": "number", "in": null, "out": { "$undefined": true } },
    { "t": "number", "in": true, "out": { "$undefined": true } },

    { "t": "boolean", "in": "yes", "out": true },
    { "t": "boolean", "in": " Y ", "out": true },
    { "t": "boolean", "in": "T", "out": true },
    { "t": "boolean", "in": "checked", "out": true },
    { "t": "boolean", "in": "on", "out": true },
    { "t": "boolean", "in": "1", "out": true },
    { "t": "boolean", "in": 0, "out": false },
    { "t": "boolean", "in": "No", "out": false },
    { "t": "boolean", "in": "unchecked", "out": false },
    { "t": "boolean", "in": false, "out": false },
    { "t": "boolean", "in": "maybe", "out": { "$undefined": true } },
    { "t": "boolean", "in": "n/a", "out": { "$undefined": true } },
    { "t": "boolean", "in": "", "out": { "$undefined": true } },

    { "t": "date", "in": "2026-03-04", "out": "2026-03-04" },
    { "t": "date", "in": "2026-11-22T10:00:00+13:00", "out": "2026-11-22T10:00:00+13:00" },
    { "t": "date", "in": "2026-11-22 10:00", "out": "2026-11-22T10:00:00Z" },
    { "t": "date", "in": "4 Mar 2026", "out": "2026-03-04" },
    { "t": "date", "in": "March 4, 2026", "out": "2026-03-04" },
    { "t": "date", "in": "03/04/2026", "out": { "$undefined": true } },
    { "t": "date", "arg": "day_first", "in": "03/04/2026", "out": "2026-04-03" },
    { "t": "date", "arg": "month_first", "in": "03/04/2026", "out": "2026-03-04" },
    { "t": "date", "arg": "day_first", "in": "25/12/26", "out": "2026-12-25" },
    { "t": "date", "arg": "day_first", "in": "25/12/70", "out": "1970-12-25" },
    { "t": "date", "arg": "month_first", "in": "12/25/2026 3:05 PM", "out": "2026-12-25T15:05:00Z" },
    { "t": "date", "arg": "day_first", "in": "31/02/2026", "out": { "$undefined": true } },
    { "t": "date", "in": "2026-02-29", "out": { "$undefined": true } },
    { "t": "date", "in": "2028-02-29", "out": "2028-02-29" },
    { "t": "date", "in": 45720, "out": "2025-03-04" },
    { "t": "date", "in": "45720", "out": "2025-03-04" },
    { "t": "date", "in": 60, "out": { "$undefined": true } },
    { "t": "date", "in": "not a date", "out": { "$undefined": true } },
    { "t": "date", "in": "", "out": { "$undefined": true } },

    { "t": "epoch_to_datetime", "in": 1700000000, "out": "2023-11-14T22:13:20.000Z" },
    { "t": "epoch_to_datetime", "in": 1700000000000, "out": "2023-11-14T22:13:20.000Z" },
    { "t": "epoch_to_datetime", "in": "1700000000", "out": "2023-11-14T22:13:20.000Z" },
    { "t": "epoch_to_datetime", "in": "soon", "out": { "$undefined": true } },
    { "t": "epoch_to_datetime", "in": "", "out": { "$undefined": true } },

    { "t": "default_if_empty", "arg": "unknown", "in": "", "out": "unknown" },
    { "t": "default_if_empty", "arg": "unknown", "in": "   ", "out": "unknown" },
    { "t": "default_if_empty", "arg": "unknown", "in": null, "out": "unknown" },
    { "t": "default_if_empty", "arg": "unknown", "in": [], "out": "unknown" },
    { "t": "default_if_empty", "arg": "unknown", "in": "set", "out": "set" },
    { "t": "default_if_empty", "arg": "unknown", "in": 0, "out": 0 },

    { "t": "join_lines", "in": ["a", "b", 3], "out": "a\nb\n3" },
    { "t": "join_lines", "in": "already text", "out": "already text" },
    { "t": "split_lines", "in": " a \r\n\nb\n", "out": ["a", "b"] },
    { "t": "split_lines", "in": 5, "out": 5 },

    { "t": "minor_units_to_decimal", "in": 1234, "out": 12.34 },
    { "t": "minor_units_to_decimal", "arg": "3", "in": "1234", "out": 1.234 },
    { "t": "minor_units_to_decimal", "arg": "0", "in": 1234, "out": 1234 },
    { "t": "minor_units_to_decimal", "arg": "9", "in": 1234, "out": { "$undefined": true } },
    { "t": "minor_units_to_decimal", "in": "lots", "out": { "$undefined": true } },

    { "t": "choice_map", "map": { "High": "1", "Low": "3" }, "in": "High", "out": "1" },
    { "t": "choice_map", "map": { "High": "1", "Low": "3" }, "in": "  Low ", "out": "3" },
    { "t": "choice_map", "map": { "High": "1", "Low": "3" }, "in": "Medium", "out": "Medium" },
    { "t": "choice_map", "map": { "2": "two" }, "in": 2, "out": "two" },
    { "t": "choice_map", "map": { "High": "1" }, "in": "", "out": { "$undefined": true } }
  ],
  "bad_args": [
    { "t": "date", "arg": "dd/mm/yyyy" },
    { "t": "number", "arg": "european" }
  ]
}
