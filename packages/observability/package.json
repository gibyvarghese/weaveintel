{
  "name": "@weaveintel/observability",
  "version": "0.2.1",
  "description": "Tracing, cost tracking, and run logging implementations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gibyvarghese/weaveintel.git",
    "directory": "packages/observability"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./replay": {
      "import": "./dist/replay/index.js",
      "types": "./dist/replay/index.d.ts",
      "default": "./dist/replay/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@weaveintel/core": "^0.3.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ]
}
